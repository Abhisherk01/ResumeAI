# --- Application ---
APP_NAME=ResumeAI
ENVIRONMENT=development
DEBUG=true

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Inside Docker the host is "db". Running locally without Docker: use localhost.
DATABASE_URL=postgresql+psycopg://resumeai:resumeai@db:5432/resumeai

# --- Sessions (used from Phase 3) ---
# SESSION_SECRET_KEY=change-me-to-a-long-random-string

# --- AI provider (used from Phase 6) ---
# AI_PROVIDER=gemini
# GEMINI_API_KEY=