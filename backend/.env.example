# --- Application ---
APP_NAME=ResumeAI
ENVIRONMENT=development
DEBUG=true

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Inside Docker the host is "db". Running locally without Docker: use localhost.
DATABASE_URL=postgresql+psycopg://resumeai:resumeai@db:5432/resumeai

# --- Email (Phase 12, D31) ---
# "console" (default): emails print to the backend log - links included.
# "resend": posts to Resend's API. Requires RESEND_API_KEY and a verified
# EMAIL_FROM_ADDRESS (Resend dashboard). Production sets all three.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=ResumeAI <onboarding@resend.dev>

# --- AI (Phase 6) ---
# "mock" (default) needs nothing. "gemini" requires GEMINI_API_KEY.
AI_PROVIDER=mock
GEMINI_API_KEY=

# --- Sessions ---
# Cookie security flags derive from ENVIRONMENT (Secure in production).
# Lifetimes are configurable: SESSION_TTL_HOURS, EMAIL_TOKEN_TTL_HOURS,
# RESET_TOKEN_TTL_MINUTES (sensible defaults are built in).
