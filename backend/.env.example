# --- Application ---
APP_NAME=ResumeAI
ENVIRONMENT=development
DEBUG=true

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Inside Docker the host is "db". Running locally without Docker: use localhost.
DATABASE_URL=postgresql+psycopg://resumeai:resumeai@db:5432/resumeai

# --- Sessions ---
# Opaque server-side sessions: no signing key is required. Cookie security
# flags are derived from ENVIRONMENT (Secure when ENVIRONMENT=production).
# Lifetimes are configurable: SESSION_TTL_HOURS, EMAIL_TOKEN_TTL_HOURS,
# RESET_TOKEN_TTL_MINUTES (sensible defaults are built in).
